{
  "description": "BetterLoop verifies Codex turns before they stop.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/betterloop-stop.cjs\"",
            "commandWindows": "node \"$(git rev-parse --show-toplevel)/scripts/betterloop-stop.cjs\"",
            "timeout": 30,
            "statusMessage": "BetterLoop is checking whether the job is 100% done"
          }
        ]
      }
    ]
  }
}
